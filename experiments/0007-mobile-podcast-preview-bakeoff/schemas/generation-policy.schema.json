{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generation-policy.schema.json",
  "type": "object",
  "required": ["schema_version", "generation_slots", "host_memory_bytes", "safety_margin_bytes", "measurements"],
  "properties": {
    "schema_version": {"const": 1},
    "generation_slots": {"type": "integer", "minimum": 1, "maximum": 2},
    "host_memory_bytes": {"type": "integer", "minimum": 1},
    "safety_margin_bytes": {"type": "integer", "minimum": 0},
    "measurements": {"type": "array", "items": {"type": "object", "required": ["model", "peak_process_tree_rss_bytes"], "properties": {"model": {"type": "string"}, "peak_process_tree_rss_bytes": {"type": "integer", "minimum": 0}}}}
  },
  "additionalProperties": true
}
