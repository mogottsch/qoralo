{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generation-policy.schema.json",
  "$defs": {
    "operation": {"enum": ["smoke-load", "preflight", "generation-realtime", "generation-pocket", "generation-kokoro", "capture", "export", "protocol-revision"]},
    "measurement": {
      "type": "object",
      "required": ["model", "peak_process_tree_rss_bytes"],
      "properties": {
        "model": {"enum": ["realtime", "pocket", "kokoro"]},
        "peak_process_tree_rss_bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    }
  },
  "type": "object",
  "required": ["schema_version", "policy_version", "mode", "compatible_concurrent_sets", "covered_operations", "rule"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "policy_version": {"type": "integer", "minimum": 1, "maximum": 2},
    "mode": {"enum": ["exclusive", "measured-pocket-kokoro"]},
    "compatible_concurrent_sets": {
      "oneOf": [
        {"const": []},
        {"const": [["generation-pocket", "generation-kokoro"]]}
      ]
    },
    "covered_operations": {
      "type": "array",
      "items": {"$ref": "#/$defs/operation"},
      "uniqueItems": true,
      "minItems": 8
    },
    "host_memory_bytes": {"type": "integer", "minimum": 1},
    "host_limit_bytes": {"type": "integer", "minimum": 1, "maximum": 34359738368},
    "safety_margin_bytes": {"type": "integer", "minimum": 1},
    "combined_pocket_kokoro_peak_bytes": {"type": "integer", "minimum": 0},
    "combined_with_safety_margin_bytes": {"type": "integer", "minimum": 1},
    "headroom_bytes": {"type": "integer", "minimum": 1},
    "measurements": {"type": "array", "items": {"$ref": "#/$defs/measurement"}, "minItems": 3},
    "rule": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "exclusive"}}},
      "then": {"properties": {"policy_version": {"const": 1}, "compatible_concurrent_sets": {"const": []}}}
    },
    {
      "if": {"properties": {"mode": {"const": "measured-pocket-kokoro"}}},
      "then": {
        "required": ["host_memory_bytes", "host_limit_bytes", "safety_margin_bytes", "combined_pocket_kokoro_peak_bytes", "combined_with_safety_margin_bytes", "headroom_bytes", "measurements"],
        "properties": {"policy_version": {"const": 2}, "compatible_concurrent_sets": {"const": [["generation-pocket", "generation-kokoro"]]}}
      }
    }
  ],
  "additionalProperties": false
}
