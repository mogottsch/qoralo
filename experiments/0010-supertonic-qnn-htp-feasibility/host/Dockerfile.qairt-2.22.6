# Host-only container for the user-supplied QAIRT 2.22.6 converter tools.
# The proprietary SDK is mounted read-only at /opt/qairt; it is never copied
# into this image or repository.
FROM ubuntu@sha256:3b06811b2afd352be909dd088a004166d665dc76d38b13eada33522a9d915c6f

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      clang-14 \
      cmake \
      git \
      libpython3.10 \
      libunwind-14 \
      ninja-build \
      python3-pip \
      python3.10 \
      python3.10-venv \
 && rm -rf /var/lib/apt/lists/*

# Versions follow sdk.yaml and check-python-dependency from QAIRT 2.22.6.
RUN python3.10 -m pip install --no-cache-dir \
      Mako==1.1.0 \
      cmake==3.29.6 \
      numpy==1.26.4 \
      onnx==1.12.0 \
      packaging==24.0 \
      pandas==2.0.1 \
      protobuf==3.19.6 \
      PyYAML==6.0.2 \
      tabulate==0.9.0 \
      xlsxwriter==1.2.2

ENV QNN_SDK_ROOT=/opt/qairt
ENV PYTHONPATH=/opt/qairt/lib/python:/opt/qairt/benchmarks/QNN
ENV PATH=/opt/qairt/bin/x86_64-linux-clang:${PATH}
ENV LD_LIBRARY_PATH=/opt/qairt/lib/x86_64-linux-clang:/usr/lib/llvm-14/lib

WORKDIR /work
