{
  "dialog": {
    "version": 1,
    "type": "basic",
    "max-num-tokens": 2048,
    "context": {
      "version": 1,
      "size": 4096,
      "n-vocab": 262144,
      "bos-token": -1,
      "eos-token": [
        1,
        106
      ],
      "pad-token": 0
    },
    "sampler": {
      "version": 1,
      "seed": 42,
      "temp": 0.0,
      "top-k": 1,
      "top-p": 1.0,
      "greedy": true
    },
    "tokenizer": {
      "version": 1,
      "path": "./tokenizer.json"
    },
    "engine": {
      "version": 1,
      "n-threads": 3,
      "backend": {
        "version": 1,
        "type": "QnnHtp",
        "QnnHtp": {
          "version": 1,
          "use-mmap": true,
          "spill-fill-bufsize": 0,
          "mmap-budget": 40,
          "poll": true,
          "cpu-mask": "0xe0",
          "kv-dim": 256,
          "allow-async-init": true,
          "enable-graph-switching": true
        },
        "extensions": "./htp_backend_ext_config.json"
      },
      "cache-groups": [
        {
          "version": 1,
          "prefix": "past_",
          "kv-dim": 512,
          "attention-mask-tensor-name": "attention_mask"
        },
        {
          "version": 1,
          "prefix": "swa_",
          "kv-dim": 256,
          "attention-mask-tensor-name": "swa_attention_mask",
          "longcontext": {
            "version": 1,
            "type": "sliding-window",
            "sliding-window": {
              "version": 1,
              "window-size": 512
            }
          }
        }
      ],
      "model": {
        "version": 1,
        "type": "binary",
        "binary": {
          "version": 1,
          "ctx-bins": [
            "./models/weight_sharing_model_ar128_ar1_cl4096_scl512_1_of_1.serialized.bin"
          ]
        },
        "positional-encoding": [
          {
            "type": "rope",
            "rope-dim": 256,
            "rope-theta": 1000000.0,
            "rope-scaling": {
              "rope-type": "proportional",
              "partial-rotary-factor": 0.25
            }
          },
          {
            "prefix": "swa_",
            "type": "rope",
            "rope-dim": 128,
            "rope-theta": 10000.0
          }
        ]
      }
    },
    "embedding": {
      "version": 1,
      "type": "lut",
      "lut-path": "./embedding_int8_lut.bin",
      "size": 1536,
      "datatype": "ufixed8",
      "quant-param": {
        "scale": 0.050521295210894414,
        "offset": -170
      }
    },
    "perlayer-embedding": {
      "version": 1,
      "type": "lut",
      "lut-path": "./embed_tokens_per_layer_int8_lut.bin",
      "size": 8960,
      "datatype": "ufixed8",
      "quant-param": {
        "scale": 0.1107082815731273,
        "offset": -134
      }
    }
  }
}
