{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark-descriptor.schema.json",
  "title": "Experiment 0008 Android launch descriptor",
  "type": "object",
  "required": ["schema_version", "candidate", "deployment_variant", "transcript", "transcript_sha256", "sherpa_config_path", "provider", "num_threads", "warm_runs", "speaker_id", "language", "storage", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "candidate": {"enum": ["pocket", "kokoro", "supertonic_3"]},
    "deployment_variant": {"type": "string", "minLength": 1},
    "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "transcript": {"const": "protocol/transcript.txt"},
    "transcript_sha256": {"const": "350c8d3d57525e65085b1d7c5ec733985c5467797cf50508b5e2a4eee313471f"},
    "sherpa_config_path": {"type": "string", "pattern": "^models/[^/]+/sherpa-config\\.json$"},
    "provider": {"const": "cpu"},
    "num_threads": {"const": 1},
    "warm_runs": {"type": "integer", "minimum": 3},
    "speaker_id": {"type": "integer", "minimum": 0},
    "language": {"type": "string", "minLength": 2},
    "storage": {"const": "app_specific_external_files"},
    "files": {
      "type": "object",
      "minProperties": 3,
      "propertyNames": {"pattern": "^(protocol|models)/"},
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  },
  "additionalProperties": true
}
