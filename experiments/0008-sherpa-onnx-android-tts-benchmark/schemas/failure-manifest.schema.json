{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "failure-manifest.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "experiment", "candidate_id", "outcome", "reason", "exit_state", "metrics", "evidence"],
  "properties": {"schema_version": {"const": 1}, "experiment": {"const": "0008"}, "candidate_id": {"enum": ["pocket", "kokoro", "supertonic_3"]}, "outcome": {"enum": ["blocked", "timeout", "native_crash", "oom", "invalid_audio", "failure"]}, "reason": {"type": "string", "minLength": 1}, "exit_state": {"type": ["string", "integer", "null"]}, "metrics": {"type": "object", "additionalProperties": {"type": "object", "required": ["value", "reason"], "properties": {"value": {"type": "null"}, "reason": {"type": "string", "minLength": 1}}}}, "evidence": {"type": "array"}}
}
