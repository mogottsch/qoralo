{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://preview.moket-home.de/vibevoice/android-llm-benchmarks/registry.schema.json",
  "title": "Android LLM benchmark registry",
  "type": "object",
  "required": [
    "schema_version",
    "registry_id",
    "source_policy",
    "canonical_device",
    "benchmark_contract",
    "entries"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "registry_id": {"const": "android-llm-benchmarks-v1"},
    "source_policy": {"type": "string", "minLength": 1},
    "canonical_device": {"$ref": "#/$defs/device"},
    "benchmark_contract": {
      "type": "object",
      "required": ["path", "sha256", "workload_manifest"],
      "properties": {
        "path": {"const": "protocols/android-llm-benchmark/contract.json"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "workload_manifest": {"const": "protocols/android-llm-benchmark/workloads/inference-v1/SHA256SUMS"}
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullable_metric": {"type": ["number", "null"], "minimum": 0},
    "device": {
      "type": "object",
      "required": ["model", "soc", "serial", "abi"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "soc": {"type": "string", "minLength": 1},
        "serial": {"type": "string", "minLength": 1},
        "abi": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "model_identity": {
      "type": "object",
      "required": ["name", "url", "revision"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri-reference", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["path", "sha256", "bytes", "format"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "format": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "quantization": {
      "type": "object",
      "required": ["name", "bits", "scheme", "source", "tool", "tool_revision"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "bits": {"type": ["integer", "null"], "minimum": 1},
        "scheme": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "tool": {"type": ["string", "null"]},
        "tool_revision": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "tokenizer": {
      "type": "object",
      "required": ["name", "url", "revision", "chat_template_source", "chat_template_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri-reference", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "chat_template_source": {"type": "string", "minLength": 1},
        "chat_template_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["name", "version", "revision", "provider", "threads", "options"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "revision": {"type": ["string", "null"]},
        "provider": {"type": "string", "minLength": 1},
        "threads": {"type": ["integer", "null"], "minimum": 1},
        "options": {"type": "object"}
      },
      "additionalProperties": false
    },
    "workload": {
      "type": "object",
      "required": ["contract_id", "tier", "path", "sha256", "rendered_prompt_sha256", "input_bytes", "input_tokens", "token_ids_sha256", "context_limit_tokens", "max_new_tokens", "truncated"],
      "properties": {
        "contract_id": {"const": "android-llm-inference-v1"},
        "tier": {"enum": ["short", "medium", "long"]},
        "path": {"type": "string", "pattern": "^protocols/android-llm-benchmark/workloads/inference-v1/(short|medium|long)\\.json$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "rendered_prompt_sha256": {"$ref": "#/$defs/sha256"},
        "input_bytes": {"type": "integer", "minimum": 1, "description": "Sum of exact UTF-8 bytes in canonical system and user message content before route-specific chat-template rendering."},
        "input_tokens": {"type": "integer", "minimum": 1},
        "token_ids_sha256": {"$ref": "#/$defs/sha256"},
        "context_limit_tokens": {"type": "integer", "minimum": 1},
        "max_new_tokens": {"const": 2048},
        "truncated": {"const": false}
      },
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "required": ["request_to_first_token_seconds", "prefill_seconds", "post_prefill_to_first_token_seconds", "decode_seconds", "total_seconds"],
      "properties": {
        "request_to_first_token_seconds": {"$ref": "#/$defs/nullable_metric"},
        "prefill_seconds": {"$ref": "#/$defs/nullable_metric"},
        "post_prefill_to_first_token_seconds": {"$ref": "#/$defs/nullable_metric"},
        "decode_seconds": {"$ref": "#/$defs/nullable_metric"},
        "total_seconds": {"$ref": "#/$defs/nullable_metric"}
      },
      "additionalProperties": false
    },
    "throughput": {
      "type": "object",
      "required": ["prefill_tokens_per_second", "decode_tokens_per_second", "decode_first_token_included"],
      "properties": {
        "prefill_tokens_per_second": {"$ref": "#/$defs/nullable_metric"},
        "decode_tokens_per_second": {"$ref": "#/$defs/nullable_metric"},
        "decode_first_token_included": {"type": ["boolean", "null"]}
      },
      "additionalProperties": false
    },
    "output_sanity": {
      "oneOf": [
        {
          "type": "object",
          "required": ["looks_sensible", "issue_notes"],
          "properties": {
            "looks_sensible": {"const": true},
            "issue_notes": {"type": "null"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["looks_sensible", "issue_notes"],
          "properties": {
            "looks_sensible": {"const": false},
            "issue_notes": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["looks_sensible", "issue_notes"],
          "properties": {
            "looks_sensible": {"type": "null"},
            "issue_notes": {"type": "null"}
          },
          "additionalProperties": false
        }
      ]
    },
    "output": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": ["id", "phase", "tier", "input_tokens", "output_token_cap", "output_tokens", "stop_reason", "timing", "throughput", "output", "output_sanity", "missing_reasons"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "phase": {"enum": ["first", "same_session"]},
        "tier": {"enum": ["short", "medium", "long"]},
        "input_tokens": {"type": "integer", "minimum": 1},
        "output_token_cap": {"const": 2048},
        "output_tokens": {"type": "integer", "minimum": 0, "maximum": 2048},
        "stop_reason": {"enum": ["eos", "stop_sequence", "max_tokens", "timeout", "error"]},
        "timing": {"$ref": "#/$defs/timing"},
        "throughput": {"$ref": "#/$defs/throughput"},
        "output": {"$ref": "#/$defs/output"},
        "output_sanity": {"$ref": "#/$defs/output_sanity"},
        "missing_reasons": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "setup": {
      "type": "object",
      "required": ["seconds", "boundary", "components"],
      "properties": {
        "seconds": {"$ref": "#/$defs/nullable_metric"},
        "boundary": {"type": "string", "minLength": 1},
        "components": {"type": "object", "additionalProperties": {"$ref": "#/$defs/nullable_metric"}}
      },
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "required": ["peak_pss_bytes", "peak_vm_hwm_bytes", "method", "sampling_interval_seconds", "lifecycle"],
      "properties": {
        "peak_pss_bytes": {"type": ["integer", "null"], "minimum": 0},
        "peak_vm_hwm_bytes": {"type": ["integer", "null"], "minimum": 0},
        "method": {"type": "string", "minLength": 1},
        "sampling_interval_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "lifecycle": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "aggregates": {
      "type": "object",
      "required": ["by_tier"],
      "properties": {
        "by_tier": {
          "type": "object",
          "required": ["short", "medium", "long"],
          "properties": {
            "short": {"$ref": "#/$defs/tier_aggregate"},
            "medium": {"$ref": "#/$defs/tier_aggregate"},
            "long": {"$ref": "#/$defs/tier_aggregate"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tier_aggregate": {
      "type": "object",
      "required": ["same_session_count", "median_request_to_first_token_seconds", "median_prefill_tokens_per_second", "median_decode_tokens_per_second", "median_total_seconds"],
      "properties": {
        "same_session_count": {"type": "integer", "minimum": 0},
        "median_request_to_first_token_seconds": {"$ref": "#/$defs/nullable_metric"},
        "median_prefill_tokens_per_second": {"$ref": "#/$defs/nullable_metric"},
        "median_decode_tokens_per_second": {"$ref": "#/$defs/nullable_metric"},
        "median_total_seconds": {"$ref": "#/$defs/nullable_metric"}
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["id", "experiment", "model", "model_identity", "artifacts", "quantization", "tokenizer", "route", "execution_target", "attempt_status", "runtime", "device", "workloads", "setup", "runs", "aggregates", "memory", "thermal", "summary", "limitations", "sources", "missing_reasons"],
      "properties": {
        "id": {"type": "string", "pattern": "^[0-9]{4}-[a-z0-9-]+$"},
        "experiment": {"type": "string", "pattern": "^[0-9]{4}$"},
        "model": {"type": "string", "minLength": 1},
        "model_identity": {"$ref": "#/$defs/model_identity"},
        "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
        "quantization": {"$ref": "#/$defs/quantization"},
        "tokenizer": {"$ref": "#/$defs/tokenizer"},
        "route": {"type": "string", "minLength": 1},
        "execution_target": {"enum": ["android", "host"]},
        "attempt_status": {"enum": ["ran", "partial", "blocked", "not_run"]},
        "runtime": {"$ref": "#/$defs/runtime"},
        "device": {"anyOf": [{"$ref": "#/$defs/device"}, {"type": "null"}]},
        "workloads": {
          "type": "object",
          "required": ["short", "medium", "long"],
          "properties": {
            "short": {"$ref": "#/$defs/workload"},
            "medium": {"$ref": "#/$defs/workload"},
            "long": {"$ref": "#/$defs/workload"}
          },
          "additionalProperties": false
        },
        "setup": {"$ref": "#/$defs/setup"},
        "runs": {"type": "array", "items": {"$ref": "#/$defs/run"}},
        "aggregates": {"$ref": "#/$defs/aggregates"},
        "memory": {"$ref": "#/$defs/memory"},
        "thermal": {"type": "object"},
        "summary": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "missing_reasons": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  }
}
