{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://preview.moket-home.de/vibevoice/android-benchmarks/registry.schema.json",
  "title": "Global Android benchmark registry",
  "type": "object",
  "required": ["schema_version", "registry_id", "device", "source_policy", "model_timeline", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_id": {"const": "android-benchmarks-v1"},
    "source_policy": {"type": "string", "minLength": 1},
    "model_timeline": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/timeline_entry"}},
    "device": {"$ref": "#/$defs/device"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "additionalProperties": false,
  "$defs": {
    "device": {
      "type": "object",
      "required": ["model", "soc", "serial", "abi"],
      "properties": {
        "model": {"type": "string"}, "soc": {"type": "string"},
        "serial": {"type": "string"}, "abi": {"type": "string"}
      }, "additionalProperties": false
    },
    "metric": {"type": ["number", "null"], "minimum": 0},
    "technical_execution": {
      "type": "object", "required": ["status", "android_attempted", "provider", "threads"],
      "properties": {
        "status": {"enum": ["ran", "partial", "blocked", "deferred", "not_run"]},
        "android_attempted": {"type": "boolean"},
        "provider": {"type": ["string", "null"]},
        "threads": {"type": ["integer", "null"], "minimum": 1}
      }, "additionalProperties": false
    },
    "structural_audio": {
      "type": "object", "required": ["status", "basis", "sample_sha256"],
      "properties": {
        "status": {"enum": ["valid", "invalid", "unavailable"]},
        "basis": {"type": ["string", "null"]},
        "sample_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }, "additionalProperties": false
    },
    "objective_evidence": {
      "type": "object", "required": ["status", "summary", "comparison_notes"],
      "properties": {
        "status": {"enum": ["not_recorded", "descriptive", "pass", "fail"]},
        "summary": {"type": "string", "minLength": 1},
        "comparison_notes": {"type": "array", "items": {"type": "string"}}
      }, "additionalProperties": false
    },
    "listening_review": {
      "type": "object", "required": ["status", "reviewer", "date", "notes", "sample_sha256"],
      "properties": {
        "status": {"enum": ["not_reviewed", "accepted", "rejected"]},
        "reviewer": {"type": ["string", "null"]},
        "date": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "notes": {"type": ["string", "null"]},
        "sample_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }, "additionalProperties": false
    },
    "timeline_entry": {
      "type": "object", "required": ["model", "first_release_date", "date_basis", "source_url"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "first_release_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "date_basis": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri-reference", "minLength": 1}
      }, "additionalProperties": false
    },
    "model_identity": {
      "type": "object", "required": ["name", "url", "revision"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri-reference", "minLength": 1},
        "revision": {"type": ["string", "null"]}
      }, "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["id", "experiment", "model", "model_identity", "route", "deployment_variant", "quantization", "scope", "attempt_status", "technical_execution", "structural_audio", "objective_evidence", "listening_review", "android_attempted", "provider", "precision", "threads", "device", "metrics", "wav", "summary", "limitations", "sources", "missing_reasons"],
      "properties": {
        "id": {"type": "string", "pattern": "^[0-9]{4}-[a-z0-9-]+$"},
        "experiment": {"type": "string", "pattern": "^[0-9]{4}$"},
        "model": {"type": "string"},
        "model_identity": {"anyOf": [{"$ref": "#/$defs/model_identity"}, {"type": "null"}]},
        "route": {"type": "string"},
        "deployment_variant": {"type": "string"},
        "quantization": {"type": ["string", "null"]},
        "scope": {"enum": ["full_e2e", "excluded_non_e2e"]},
        "attempt_status": {"enum": ["ran", "partial", "blocked", "deferred", "not_run"]},
        "technical_execution": {"$ref": "#/$defs/technical_execution"},
        "structural_audio": {"$ref": "#/$defs/structural_audio"},
        "objective_evidence": {"$ref": "#/$defs/objective_evidence"},
        "listening_review": {"$ref": "#/$defs/listening_review"},
        "android_attempted": {"type": "boolean"},
        "provider": {"type": ["string", "null"]}, "precision": {"type": ["string", "null"]},
        "threads": {"type": ["integer", "null"], "minimum": 1},
        "device": {"anyOf": [{"$ref": "#/$defs/device"}, {"type": "null"}]},
        "metrics": {
          "type": "object", "required": ["load_seconds", "cold_rtf", "warm_median_rtf", "peak_pss_bytes", "peak_vm_hwm_bytes"],
          "properties": {"load_seconds": {"$ref": "#/$defs/metric"}, "cold_rtf": {"$ref": "#/$defs/metric"}, "warm_median_rtf": {"$ref": "#/$defs/metric"}, "peak_pss_bytes": {"$ref": "#/$defs/metric"}, "peak_vm_hwm_bytes": {"$ref": "#/$defs/metric"}},
          "additionalProperties": false
        },
        "wav": {"anyOf": [{"$ref": "#/$defs/wav"}, {"type": "null"}]},
        "summary": {"type": "string", "minLength": 1}, "limitations": {"type": "array", "items": {"type": "string"}},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "missing_reasons": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "wav": {
      "type": "object",
      "required": ["path", "sha256", "bytes", "sample_rate_hz", "channels", "duration_seconds", "verified"],
      "properties": {
        "path": {"type": "string", "pattern": "^media/.+\\.wav$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 1},
        "sample_rate_hz": {"type": "integer", "minimum": 1}, "channels": {"type": "integer", "minimum": 1},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0}, "verified": {"const": true}
      }, "additionalProperties": false
    }
  }
}
