{
  "concurrency": {
    "workers": 2,
    "max": 3
  },
  "dependencies": "strict",
  "coordination": "chatty",
  "models": {
    "planner": "github-copilot/gpt-5.6-sol",
    "worker": "github-copilot/gpt-5.6-sol",
    "reviewer": "github-copilot/gpt-5.6-sol",
    "analyst": "github-copilot/gpt-5.6-sol"
  },
  "review": {
    "enabled": true,
    "maxIterations": 3
  },
  "planning": {
    "maxPasses": 2
  },
  "work": {
    "maxAttemptsPerTask": 3,
    "maxWaves": 50,
    "shutdownGracePeriodMs": 30000
  }
}
