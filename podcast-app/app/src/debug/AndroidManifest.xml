<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".gallery.SyntheticGalleryActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.ui_gallery"
            android:excludeFromRecents="true"
            android:process=":ui_gallery"
            android:windowSoftInputMode="adjustResize" />
        <service
            android:name=".wiring.DurationLoadService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:process=":generation" />
        <service
            android:name=".wiring.RuntimeWiringService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:process=":generation" />
        <service
            android:name=".runtime.OwnedAudioGuardProbeService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:process=":guard_probe" />
    </application>
</manifest>
